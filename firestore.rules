rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users: read own profile, write own profile ──
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── User Profiles (admin-created) ──
    match /userProfiles/{profileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Towers: all authenticated users can read, only admin can write ──
    match /towers/{towerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Tickets: users can create + read their own; NOC/admin can read all ──
    match /tickets/{ticketId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // ── Jobs: authenticated users can read/write ──
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;
    }

    // ── Engineers: read by all, write by all (for status updates) ──
    match /engineers/{engineerId} {
      allow read, write: if request.auth != null;
    }

    // ── Alarms: all authenticated users can read; system can write ──
    match /alarms/{alarmId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Audit Logs: all authenticated users can read ──
    match /auditLogs/{logId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── System Config (AI settings, etc.) ──
    match /systemConfig/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
